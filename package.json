{
  "name": "clawhunt-1827-miniprogram-scaffold",
  "version": "1.0.0",
  "private": true,
  "description": "WeChat native mini program scaffold: TypeScript strict + tdesign-miniprogram + 5 tabs + 2 subpackages",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --ext .ts,.js,.mjs --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci --runInBand",
    "verify:app": "node scripts/verify-app-json.mjs",
    "preview:shots": "node scripts/render-preview.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:app && npm run verify:sdk",
    "build:npm": "node scripts/build-npm.mjs",
    "verify:sdk": "node scripts/check-no-tracking-sdk.mjs",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.3.0",
    "miniprogram-api-typings": "^5.3.1",
    "miniprogram-simulate": "^1.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
